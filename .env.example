# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Server-only. Nunca exposto ao browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── Claude API (Anthropic) ────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
# Modelo default dos agentes (sobrescrevível por agente em agents.settings.model)
ANTHROPIC_DEFAULT_MODEL="claude-opus-5-5"

# ── Cernio (mensageria) ───────────────────────────────────
# Sem contrato final ainda; adapter é stub até credenciais chegarem.
CERNIO_API_URL="https://api.cernio.com"
CERNIO_API_KEY=""
CERNIO_WEBHOOK_SECRET=""

# ── Google Calendar (OAuth 2.0) — fase 2 ──────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Segredo p/ cron jobs da Vercel (lembretes, outbox)
CRON_SECRET=""
