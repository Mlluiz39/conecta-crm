# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Server-only. Nunca exposto ao browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── Claude API (Anthropic) ────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
# Modelo default dos agentes (sobrescrevível por agente em agents.settings.model)
ANTHROPIC_DEFAULT_MODEL="claude-opus-5-5"

# ── Google Calendar (OAuth 2.0) — fase 2 ──────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Segredo p/ cron jobs da Vercel (lembretes, outbox)
CRON_SECRET=""

# ── Telegram — alertas do CRM (bot só do CRM) ─────────────
# Crie um bot no @BotFather e use O TOKEN DELE aqui — não reaproveite o bot do Hermes.
# Sem as duas variáveis o CRM não envia alerta (e avisa o que está faltando em
# GET /api/cron/alerts). Fale /start com o bot antes: bot não inicia conversa sozinho.
TELEGRAM_BOT_TOKEN="123456789:cole_o_token_do_bot_do_crm"
# Seu id de usuário/chat que recebe os alertas (@userinfobot mostra o id)
ALERTS_TELEGRAM_CHAT_ID=""

# ── Telegram como canal de atendimento (mesmo bot) ────────
# Ligue com: node scripts/setup-telegram-channel.mjs https://seu-dominio
# (o script grava o canal + o agente e registra o webhook na Bot API)
# secret_token do webhook: o Telegram devolve no header e o CRM valida. Gere com
#   openssl rand -hex 24
# Sem ele o endpoint /api/webhooks/telegram recusa tudo (senão qualquer um faria o agente responder).
TELEGRAM_WEBHOOK_SECRET=""
# Quem pode conversar com o bot (chat ids separados por vírgula; @userinfobot mostra o seu).
# Vazio = qualquer pessoa que achar o @ do bot é atendida pelo agente.
TELEGRAM_ALLOWED_CHAT_IDS=""
# Chat do DONO (CEO): mensagem vinda dele NÃO é lead. A conversa nasce interna (fora do inbox,
# dos alertas e do funil) e o Gerente responde em modo interno — serviços da base de
# conhecimento + andamento do CRM, só leitura. Sem esta variável vale ALERTS_TELEGRAM_CHAT_ID.
TELEGRAM_OWNER_CHAT_IDS=""

# ── Ciclo de disparo da prospecção (anti-ban) ──
OUTREACH_WINDOW_START="9"    # hora de início (horário local)
OUTREACH_WINDOW_END="18"     # hora de fim
OUTREACH_MIN_GAP_MIN="5"     # intervalo mínimo entre disparos (minutos)

# ── Transbordo (handoff) ──
# Regra do CRM: pedir outro SETOR (vendas, suporte, agendamento) transfere para o agente daquele
# papel e o bot continua atendendo. Desligar a IA é para cliente insatisfeito — o que decide isso
# é a leitura de sentimento (src/services/agents/sentiment.ts) com a regra `sentimento_negativo`
# ligada por agente em Agentes → regras.
#
# Minutos de silêncio, sem resposta humana, até a IA retomar sozinha a conversa que ficou
# em transbordo. Só vale quando NINGUÉM assumiu a conversa no CRM ("Assumir conversa" manda).
# 0 desliga a retomada automática (a conversa fica em atendimento humano até alguém reativar).
HANDOFF_AUTO_RESUME_MINUTES="30"
# Quantos pedidos de "falar com uma pessoa" (repetidos) já desligam a IA. Mínimo 2: uma menção
# isolada é pergunta, não pedido — quem transfere de setor é o roteamento, não o transbordo.
HANDOFF_HUMANO_PEDIDOS="2"

# ── Voz do atendimento (TTS) ──
# Quem gera a voz quando o lead manda nota de voz:
#   proxy      = endpoint OpenAI-compatible já configurado (Gemini via 9router) — padrão
#   piper      = serviço local leve (MIT, roda em CPU, ~4x mais rápido que o tempo real)
#   chatterbox = serviço local na VPS (MIT, roda em CPU), com voz clonada por agente
#   mlvoice    = MLVoice Engine (Pocket TTS): endpoint próprio, POST /v1/tts com X-API-Key
#   auto       = usa o local só para quem tem voz "<motor>:<nome>" em agents.voice
TTS_PROVIDER="auto"
# Base do serviço local (deploy/tts/piper/setup.sh sobe ele nesta porta, só no localhost)
PIPER_URL="http://127.0.0.1:4124"
# Base do serviço local (deploy/tts/setup-chatterbox.sh sobe ele nesta porta, só no localhost)
CHATTERBOX_URL="http://127.0.0.1:4123"
# ── MLVoice Engine (Pocket TTS) — só quando TTS_PROVIDER="mlvoice" ou agents.voice="mlvoice:<voz>" ──
# URL completa do endpoint de síntese (ou só a base: http://127.0.0.1:8765)
MLVOICE_URL="http://127.0.0.1:8765/v1/tts"
# Chave mandada no cabeçalho X-API-Key. Vazio = motor desligado (usa Piper/proxy sem erro).
MLVOICE_API_KEY=""
# Voz usada quando o agente não tem voz própria em agents.voice (ex.: rafael, jane, vera...).
# O motor v2 recusa com HTTP 422 voz fora da lista dele (/health) — a lista do painel é VOICE_CATALOG.
MLVOICE_VOICE=""
# Idioma mandado ao motor local (pt = português; o finetune pt-BR usa o mesmo id)
TTS_LANGUAGE="pt"
# Teto de espera da síntese em ms. CPU local é lento; com GPU pode baixar.
TTS_TIMEOUT_MS="180000"
# Voz do proxy quando o agente não tem voz própria; teto de texto que vira áudio
TTS_VOICE="alloy"
TTS_MAX_CHARS="600"
