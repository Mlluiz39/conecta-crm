# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Server-only. Nunca exposto ao browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── Claude API (Anthropic) ────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
# Modelo default dos agentes (sobrescrevível por agente em agents.settings.model)
ANTHROPIC_DEFAULT_MODEL="claude-opus-5-5"

# ── Google Calendar (OAuth 2.0) — fase 2 ──────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Segredo p/ cron jobs da Vercel (lembretes, outbox)
CRON_SECRET=""

# ── Telegram — alertas do CRM (bot só do CRM) ─────────────
# Crie um bot no @BotFather e use O TOKEN DELE aqui — não reaproveite o bot do Hermes.
# Sem as duas variáveis o CRM não envia alerta (e avisa o que está faltando em
# GET /api/cron/alerts). Fale /start com o bot antes: bot não inicia conversa sozinho.
TELEGRAM_BOT_TOKEN="123456789:cole_o_token_do_bot_do_crm"
# Seu id de usuário/chat que recebe os alertas (@userinfobot mostra o id)
ALERTS_TELEGRAM_CHAT_ID=""

# ── Telegram como canal de atendimento (mesmo bot) ────────
# Ligue com: node scripts/setup-telegram-channel.mjs https://seu-dominio
# (o script grava o canal + o agente e registra o webhook na Bot API)
# secret_token do webhook: o Telegram devolve no header e o CRM valida. Gere com
#   openssl rand -hex 24
# Sem ele o endpoint /api/webhooks/telegram recusa tudo (senão qualquer um faria o agente responder).
TELEGRAM_WEBHOOK_SECRET=""
# Quem pode conversar com o bot (chat ids separados por vírgula; @userinfobot mostra o seu).
# Vazio = qualquer pessoa que achar o @ do bot é atendida pelo agente.
TELEGRAM_ALLOWED_CHAT_IDS=""

# ── Ciclo de disparo da prospecção (anti-ban) ──
OUTREACH_WINDOW_START="9"    # hora de início (horário local)
OUTREACH_WINDOW_END="18"     # hora de fim
OUTREACH_MIN_GAP_MIN="5"     # intervalo mínimo entre disparos (minutos)
